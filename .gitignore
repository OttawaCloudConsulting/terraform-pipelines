# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version 
# control as they are data points which are potentially sensitive and subject 
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Plan output files
*.tfplan
*.tfplan.*
tfplan.binary
tfplan.json

# Provider lock files (generated per-platform by terraform init)
.terraform.lock.hcl

# Ignore CLI configuration files
.terraformrc
terraform.rc

# AI agent directories (Claude Code, Codex, Antigravity/Gemini)
# Only the shared investigate skill is tracked: its canonical copy lives in
# .agents/skills/ (Codex, Antigravity) and .claude/skills/investigate is a
# symlink to it. Other local skills in these directories stay ignored.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/investigate
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/investigate/
.codex/
.gemini/
.agent/

# Investigation records and evidence written by the investigate skill
/agents/

# MCP server configuration files (per-developer, may hold credentials)
.mcp.json
**/mcp.json
**/mcp_config.json

# Agent instruction files (kept local)
/AGENTS.md
/CLAUDE.md

# Scratch notes and working documents (local only)
/temp/
